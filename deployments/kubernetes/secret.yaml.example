# Kubernetes Secret Template
# For manual secret creation (if not using create-secret.sh script)
#
# Usage:
# 1. Copy: cp secret.yaml.example secret.yaml
# 2. Edit secret.yaml and replace YOUR_API_KEY_HERE
# 3. Apply: kubectl apply -f secret.yaml
#
apiVersion: v1
kind: Secret
metadata:
  name: weather-api-secret
type: Opaque
stringData:
  api-key: "YOUR_API_KEY_HERE"
